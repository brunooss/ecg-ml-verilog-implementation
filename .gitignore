# artefatos gerados (pesos, ONNX, RTL) - nao versionar
outputs/
*.hdf5
*.onnx
*.npz
*.npy
!analysis/*.txt

# ambientes / caches Python
env/
venv/
__pycache__/
*.pyc

# RTL / build de HLS
*.o
scripts/bambu/*_tb*
scripts/**/HLS_output/
# versiona o excerto de interface em rtl/, mas nao o .v completo (2.8 MB) em outputs/
!rtl/*.v

# simulacao (artefatos gerados por scripts/04_make_sim_data.py e make)
sim/build/
sim/data/
sim/output.hex
*.vcd
